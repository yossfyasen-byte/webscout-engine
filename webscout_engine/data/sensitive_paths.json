{
  "version": "1.0",
  "description": "Bundled sensitive-path catalogue. Signatures are matched against the response body to confirm that a file really is what its name claims.",
  "entries": [
    {
      "path": ".env",
      "group": "secrets",
      "severity": "critical",
      "signatures": [
        "(?m)^[A-Z][A-Z0-9_]{2,}\\s*="
      ],
      "description": "Environment file typically holding database passwords, API keys and signing secrets."
    },
    {
      "path": ".env.local",
      "group": "secrets",
      "severity": "critical",
      "signatures": [
        "(?m)^[A-Z][A-Z0-9_]{2,}\\s*="
      ],
      "description": "Local environment overrides with live credentials."
    },
    {
      "path": ".env.production",
      "group": "secrets",
      "severity": "critical",
      "signatures": [
        "(?m)^[A-Z][A-Z0-9_]{2,}\\s*="
      ],
      "description": "Production environment file with live credentials."
    },
    {
      "path": ".env.backup",
      "group": "secrets",
      "severity": "critical",
